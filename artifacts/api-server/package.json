{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "seed:official": "tsx scripts/seed-official.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config src/tests/vitest.config.ts",
    "test:watch": "vitest --config src/tests/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config src/tests/vitest.config.ts"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@workspace/ai-core": "workspace:*",
    "@workspace/platform-core": "workspace:*",
    "@workspace/queue": "workspace:*",
    "@workspace/cache": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/media-core": "workspace:*",
    "@workspace/media-db": "workspace:*",
    "@workspace/media-workers": "workspace:*",
    "@workspace/media-adapters": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "argon2": "^0.41.1",
    "helmet": "^8.0.0",
    "zod": "^3.25.76",
    "ioredis": "^5.4.2",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "4.2.0",
    "vitest": "^5.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^7.2.1"
  }
}
