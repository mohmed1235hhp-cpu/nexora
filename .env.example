# ==== Runtime ====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ==== Database ====
DATABASE_URL=postgres://cyberai:cyberai_dev@localhost:5432/cyberai

# ==== Cache / rate-limit / sessions ====
REDIS_URL=redis://localhost:6379

# ==== Auth ====
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ==== Password hashing (Argon2id) ====
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ==== CORS / cookies ====
# Comma-separated list, e.g. https://app.cyberai.example,https://admin.cyberai.example
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ==== Observability (optional) ====
SENTRY_DSN=

# --- v6 additions ---
# 32-byte base64 master key for AES-256-GCM (openssl rand -base64 32)
MASTER_ENCRYPTION_KEY=
VITE_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==== AI Providers ====
# Groq — free-tier, fast LLM inference. Powers chat + every text-based tool.
# Get a key at https://console.groq.com/keys — ROTATE any key you ever paste
# into a chat/AI tool, since it may end up logged outside your control.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Together.ai — free-tier FLUX.1 image generation. Editing (Kontext) is paid.
# Get a key at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
TOGETHER_EDIT_MODEL=black-forest-labs/FLUX.1-kontext-pro

# Anthropic Claude — paid. Powers /ai/website and /ai/app (higher-quality code
# output than the free chat models). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Video generation — paid. Powers /ai/video via Replicate's predictions API.
# Get a token at https://replicate.com/account/api-tokens
# Model slugs on Replicate change over time — verify the current one at
# https://replicate.com/collections/text-to-video before relying on the default.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=wan-video/wan-2.5-t2v-fast

# ==== Scalability upgrade (0004 / 0002_media) ====
# CDN base URL — all media/static URLs get rewritten through this at read time.
# Leave empty to fall back to STORAGE_PUBLIC_URL, else to raw storage keys.
CDN_BASE_URL=
STORAGE_PUBLIC_URL=

# Slow-query threshold (ms) — requests above this are written to perf_slow_queries.
SLOW_QUERY_MS=500

# Rate-limits (per user unless noted). Format: "<limit>/<seconds>"
RL_AI_IMAGE=30/60
RL_AI_CHAT=120/60
RL_UPLOAD=60/60
RL_LOGIN_IP=20/60

# Priority tiers — higher plan = lower priority number (runs sooner).
PRIORITY_FREE=7
PRIORITY_PRO=4
PRIORITY_PREMIUM=2
PRIORITY_ADMIN=1

# ==== Enterprise infrastructure additions ====
# Queue driver — memory (default, dev) | bullmq (prod, needs REDIS_URL)
QUEUE_DRIVER=memory

# Object storage driver — local (default, dev) | s3 | r2 | supabase
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_ROOT=./.storage

# Postgres connection pool sizing (per API/worker pod).
# Rule of thumb: (api_pods * PG_POOL_MAX) + (worker_pods * PG_POOL_MAX) < 0.8 * postgres.max_connections
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# ============================================================================
# Payments (all optional — providers stay disabled until keys are present)
# ============================================================================

# --- Stripe (global) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- PayPal (global) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Paymob (Egypt) ---
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# --- Fawry (Egypt) ---
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# --- Invoice branding ---
BILLING_SELLER_ADDRESS=

# ==== Cyber AI unified agent ====
# Gemini is the main chat/reasoning brain. Keep the key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenRouter key #1 — Qwen media: images, multimodal audio/video, ASR, video generation
OPENROUTER_MEDIA_API_KEY=
OPENROUTER_QWEN_CHAT_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_VISION_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_OMNI_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_ASR_MODEL=qwen/qwen3-asr-flash-2026-02-10
OPENROUTER_QWEN_IMAGE_MODEL=qwen/qwen-image-3-pro
OPENROUTER_QWEN_VIDEO_MODEL=alibaba/wan-2.7
QWEN_OMNI_VOICE=Cherry

# OpenRouter key #2 — isolated coding engine for websites/apps/code
OPENROUTER_CODE_API_KEY=
OPENROUTER_CODE_MODEL=qwen/qwen3-coder:free

# Free Demo AI (no provider API key required in demo mode)
DEMO_MODE=false
# Hugging Face — used for open-source video generation (HF Inference Providers)
HF_TOKEN=
# Set this to your public Hugging Face ZeroGPU Space URL after deployment
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_VIDEO_PROVIDER=auto
DEMO_INFERENCE_URL=
DEMO_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Gemini main agent + vision + image generation
GEMINI_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
