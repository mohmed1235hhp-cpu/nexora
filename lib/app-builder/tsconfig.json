{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/tests",
    "src/tests-gen",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
