{
  "name": "@workspace/app-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-driven mobile/PWA/desktop application generator: agents, generators, pipeline, review, templates and scaffolds.",
  "exports": {
    ".": "./src/index.ts",
    "./phase2": "./src/index.phase2.ts",
    "./agents": "./src/agents/index.ts",
    "./generators": "./src/generators/index.ts",
    "./pipeline": "./src/pipeline/index.ts",
    "./review": "./src/review/index.ts",
    "./templates": "./src/templates/index.ts",
    "./scaffolds": "./src/scaffolds/index.ts",
    "./security": "./src/security/index.ts",
    "./perf": "./src/perf/index.ts",
    "./reports": "./src/reports/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.1.0",
    "@workspace/agents": "workspace:*",
    "@workspace/ai-core": "workspace:*",
    "@workspace/core": "workspace:*",
    "ai": "^4.0.0",
    "zod": "catalog:",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.90.0",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
