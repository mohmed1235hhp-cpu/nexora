# ==== Production environment template — Cyber AI Platform ====
# Copy to .env (or inject via secrets manager) and fill EVERY value below.
# Generate MASTER_ENCRYPTION_KEY with: openssl rand -base64 32
# Never commit real values.

# ---- Runtime ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Database / Cache ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cyberai?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# ---- Auth / Sessions ----
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- CORS / Cookies (PROD HARDENING) ----
# Comma-separated list of production origins ONLY (no localhost).
ALLOWED_ORIGINS=https://app.cyberai.example,https://admin.cyberai.example
COOKIE_DOMAIN=.cyberai.example
COOKIE_SECURE=true

# ---- Secrets (REQUIRED) ----
# 32-byte base64 AES-256-GCM master key. Generate with:
#   openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# ---- AI Providers (REQUIRED for prod features) ----
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
TOGETHER_EDIT_MODEL=black-forest-labs/FLUX.1-kontext-pro
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=wan-video/wan-2.5-t2v-fast

# ---- Queue driver (PROD = bullmq, requires REDIS_URL) ----
QUEUE_DRIVER=bullmq

# ---- Object Storage (PROD = s3 or r2) ----
STORAGE_DRIVER=s3
STORAGE_BUCKET=cyberai-prod-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://cdn.cyberai.example
CDN_BASE_URL=https://cdn.cyberai.example

# ---- Observability (REQUIRED for prod) ----
SENTRY_DSN=
VITE_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.cyberai.example:4318

# ---- Postgres pool ----
PG_POOL_MAX=20
PG_POOL_MIN=4
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# ---- Rate limits ----
SLOW_QUERY_MS=500
RL_AI_IMAGE=30/60
RL_AI_CHAT=120/60
RL_UPLOAD=60/60
RL_LOGIN_IP=20/60

PRIORITY_FREE=7
PRIORITY_PRO=4
PRIORITY_PREMIUM=2
PRIORITY_ADMIN=1

# ==== Cyber AI unified agent ====
# Gemini is the main chat/reasoning brain. Keep the key server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenRouter key #1 — Qwen media: images, multimodal audio/video, ASR, video generation
OPENROUTER_MEDIA_API_KEY=
OPENROUTER_QWEN_CHAT_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_VISION_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_OMNI_MODEL=qwen/qwen3.5-122b-a10b
OPENROUTER_QWEN_ASR_MODEL=qwen/qwen3-asr-flash-2026-02-10
OPENROUTER_QWEN_IMAGE_MODEL=qwen/qwen-image-3-pro
OPENROUTER_QWEN_VIDEO_MODEL=disabled
# Hugging Face open-weight text-to-video model (server-side only)
HF_TOKEN=
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_VIDEO_PROVIDER=auto
QWEN_OMNI_VOICE=Cherry

# OpenRouter key #2 — isolated coding engine for websites/apps/code
OPENROUTER_CODE_API_KEY=
OPENROUTER_CODE_MODEL=qwen/qwen3-coder:free

# Free Demo AI (no provider API key required in demo mode)
DEMO_MODE=false
# Set this to your public Hugging Face ZeroGPU Space URL after deployment
DEMO_INFERENCE_URL=
DEMO_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Gemini main agent + vision + image generation
GEMINI_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional transactional email adapter (provider credentials intentionally omitted)
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
PUBLIC_APP_URL=https://your-domain.example
DATA_EXPORT_DIR=./data-exports
